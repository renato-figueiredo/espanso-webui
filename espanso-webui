#!/usr/bin/env python3
"""espanso-webui: interface web local para gerenciar os snippets do espanso.

Sobe um servidor em 127.0.0.1, abre o navegador e encerra com Ctrl+C
(ou sozinho, após um tempo sem uso). Nada fica rodando em segundo plano.

Requer: Python 3.8+ e PyYAML (python3-yaml / pip install pyyaml).
"""
import argparse
import datetime
import http.server
import json
import os
import re
import secrets
import shutil
import socket
import subprocess
import sys
import threading
import time
import urllib.parse
import webbrowser
from pathlib import Path

try:
    import yaml
except ImportError:  # pragma: no cover
    sys.exit("PyYAML não encontrado. Instale com: pip install --user pyyaml "
             "(ou o pacote python3-yaml da sua distro).")

VERSION = "1.0.0"
HERE = Path(__file__).resolve().parent
DATA_HOME = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share"))
BACKUP_DIR = DATA_HOME / "espanso-webui" / "backups"
BACKUP_KEEP = 30


# --------------------------------------------------------------------------
# YAML: leitura via PyYAML, escrita com emissor próprio (legível, multilinha
# em blocos "|" em vez de "\\n" escapado). Todo texto gerado é conferido por
# releitura antes de gravar (ver Store.save).
# --------------------------------------------------------------------------
_PLAIN_OK = re.compile(r"^[A-Za-z_][A-Za-z0-9_ ./-]*$")
_RESERVED = {"true", "false", "yes", "no", "null", "on", "off", "y", "n"}


def _scalar(s):
    """Texto em linha única; só vai sem aspas quando é inequivocamente string."""
    if _PLAIN_OK.fullmatch(s) and s.lower() not in _RESERVED and not s.endswith(" "):
        return s
    return json.dumps(s, ensure_ascii=False)  # aspas duplas, escapes válidos


def _inline(v):
    if v is None:
        return "null"
    if isinstance(v, bool):
        return "true" if v else "false"
    if isinstance(v, (int, float)):
        return str(v)
    if isinstance(v, (dict, list)):
        return json.dumps(v, ensure_ascii=False)
    return _scalar(str(v))


def _can_block(s):
    """Dá para usar bloco literal (|) sem perder fidelidade?"""
    if "\n" not in s.rstrip("\n") or s.endswith("\n\n") or "\r" in s:
        return False
    if any(ord(c) < 32 and c not in "\n\t" for c in s):
        return False
    return s[0] not in " \t\n"


def _kv(k, v, indent):
    pad = "  " * indent
    head = f"{pad}{_scalar(str(k))}:"
    if isinstance(v, str) and _can_block(v):
        body = v[:-1] if v.endswith("\n") else v
        out = [f"{head} {'|' if v.endswith(chr(10)) else '|-'}"]
        out += [("  " * (indent + 1) + ln) if ln else "" for ln in body.split("\n")]
        return out
    if isinstance(v, dict) and v:
        return [head] + _mapping(v, indent + 1)
    if isinstance(v, list) and v and all(isinstance(i, dict) and i for i in v):
        return [head] + _sequence(v, indent + 1)
    return [f"{head} {_inline(v)}"]


def _mapping(d, indent):
    out = []
    for k, v in d.items():
        out += _kv(k, v, indent)
    return out


def _sequence(items, indent):
    pad = "  " * indent
    out = []
    for it in items:
        sub = _mapping(it, indent + 1)
        sub[0] = pad + "- " + sub[0][len(pad) + 2:]
        out += sub
    return out


def dump_yaml(data):
    out = []
    order = ["global_vars", "matches"]
    keys = [k for k in order if k in data] + [k for k in data if k not in order]
    for key in keys:
        v = data[key]
        if isinstance(v, list) and v and all(isinstance(i, dict) and i for i in v):
            out += [f"{key}:"] + _sequence(v, 1)
        else:
            out += _kv(key, v, 0)
        out.append("")
    return "\n".join(out).rstrip("\n") + "\n"


# --------------------------------------------------------------------------
# Importação do Beeftext
# --------------------------------------------------------------------------
_QT_TO_STRFTIME = [
    ("yyyy", "%Y"), ("yy", "%y"), ("MMMM", "%B"), ("MMM", "%b"), ("MM", "%m"),
    ("dddd", "%A"), ("ddd", "%a"), ("dd", "%d"), ("HH", "%H"), ("hh", "%I"),
    ("mm", "%M"), ("ss", "%S"), ("AP", "%p"), ("ap", "%p"),
]
_TOKEN = re.compile(r"#\{([^{}]*)\}")


def _qt_format(fmt):
    for q, s in _QT_TO_STRFTIME:
        fmt = fmt.replace(q, s)
    return fmt


def _unique_var(vars_, base):
    names = {v["name"] for v in vars_}
    name, i = base, 1
    while name in names:
        i += 1
        name = f"{base}{i}"
    return name


def convert_snippet(snippet, warnings, kw):
    """Converte o texto de um combo Beeftext. Retorna (replace, vars, force_keys)."""
    vars_, state = [], {"keys": False, "inputs": 0}

    def repl(m):
        tok = m.group(1)
        name, _, arg = tok.partition(":")
        low = name.lower()
        if low == "cursor":
            return "$|$"
        if low == "key":
            k = arg.lower()
            if k == "tab":
                state["keys"] = True
                return "\t"
            if k in ("enter", "return"):
                state["keys"] = True
                return "\n"
            warnings.append(f"[{kw}] tecla #{{key:{arg}}} sem equivalente: removida")
            return ""
        if low == "combo":
            v = _unique_var(vars_, "combo")
            vars_.append({"name": v, "type": "match", "params": {"trigger": arg}})
            return "{{%s}}" % v
        if low in ("date", "time", "datetime"):
            v = _unique_var(vars_, "data")
            fmt = _qt_format(arg) if arg else (
                "%H:%M" if low == "time" else "%d/%m/%Y")
            vars_.append({"name": v, "type": "date", "params": {"format": fmt}})
            return "{{%s}}" % v
        if low == "clipboard":
            v = _unique_var(vars_, "clipboard")
            vars_.append({"name": v, "type": "clipboard"})
            return "{{%s}}" % v
        if low == "input":
            state["inputs"] += 1
            warnings.append(f"[{kw}] #{{input}} vira apenas o cursor "
                            "(formulários exigem o 'modulo' do espanso)")
            return "$|$" if state["inputs"] == 1 else ""
        if low == "envvar":
            v = _unique_var(vars_, "env")
            vars_.append({"name": v, "type": "shell",
                          "params": {"cmd": f"printf %s \"${arg}\""}})
            return "{{%s}}" % v
        warnings.append(f"[{kw}] #{{{tok}}} sem equivalente: mantido como texto")
        return m.group(0)

    text = _TOKEN.sub(repl, snippet)
    # "{{" literal no texto precisa de escape? o espanso só interpreta {{var}}
    return text, vars_, state["keys"]


def import_beeftext(raw):
    data = json.loads(raw) if isinstance(raw, (str, bytes)) else raw
    combos = data.get("combos")
    if combos is None:
        raise ValueError("JSON não parece um export do Beeftext (sem 'combos').")
    warnings, matches = [], []

    def walk(group_combos):
        for c in group_combos:
            kw, snippet = c.get("keyword", ""), c.get("snippet", "")
            if not kw:
                warnings.append("combo sem keyword ignorado")
                continue
            if not c.get("enabled", True):
                warnings.append(f"[{kw}] estava desabilitado no Beeftext (importado ativo)")
            text, vars_, keys = convert_snippet(snippet, warnings, kw)
            m = {"trigger": kw}
            label = (c.get("description") or c.get("name") or "").strip()
            if label:
                m["label"] = label
            if keys:
                m["force_mode"] = "keys"
            m["replace"] = text
            if vars_:
                m["vars"] = vars_
            matches.append(m)
    walk(combos)
    for g in data.get("groups", []) or []:
        walk(g.get("combos", []))
    return matches, warnings


# --------------------------------------------------------------------------
# Armazenamento
# --------------------------------------------------------------------------
class Store:
    def __init__(self, match_dir):
        self.dir = Path(match_dir).expanduser()
        self.lock = threading.Lock()

    def files(self):
        out = []
        if not self.dir.is_dir():
            return out
        for p in sorted(self.dir.rglob("*.yml")) + sorted(self.dir.rglob("*.yaml")):
            rel = p.relative_to(self.dir)
            if rel.parts[0] == "packages" or any(
                    part.startswith("_") for part in rel.parts):
                continue  # pacotes e arquivos ignorados pelo espanso
            out.append(str(rel))
        return out

    def _path(self, name):
        p = (self.dir / name).resolve()
        if self.dir.resolve() not in p.parents or p.suffix not in (".yml", ".yaml"):
            raise ValueError("arquivo inválido")
        return p

    def load(self, name):
        p = self._path(name)
        if not p.exists():
            return {"matches": [], "global_vars": [], "extra": {}}, 0
        text = p.read_text(encoding="utf-8")
        data = yaml.safe_load(text) or {}
        if not isinstance(data, dict):
            raise ValueError("estrutura YAML inesperada")
        extra = {k: v for k, v in data.items() if k not in ("matches", "global_vars")}
        return {"matches": data.get("matches") or [],
                "global_vars": data.get("global_vars") or [],
                "extra": extra}, p.stat().st_mtime_ns

    def save(self, name, payload, expected_mtime):
        p = self._path(name)
        with self.lock:
            if p.exists() and expected_mtime and p.stat().st_mtime_ns != int(expected_mtime):
                raise FileExistsError("O arquivo mudou no disco desde que você o abriu. "
                                      "Recarregue antes de salvar.")
            doc = dict(payload.get("extra") or {})
            doc["global_vars"] = payload.get("global_vars") or []
            doc["matches"] = payload.get("matches") or []
            if not doc["global_vars"]:
                doc.pop("global_vars")
            text = dump_yaml(doc)
            # valida antes de gravar: precisa reler igual
            if yaml.safe_load(text).get("matches", []) != doc["matches"]:
                raise ValueError("falha de verificação: YAML gerado difere dos dados")
            if p.exists():
                self._backup(p)
            p.parent.mkdir(parents=True, exist_ok=True)
            tmp = p.with_name(f"_{p.name}.tmp")
            tmp.write_text(text, encoding="utf-8")
            os.replace(tmp, p)
            return p.stat().st_mtime_ns

    def _backup(self, p):
        BACKUP_DIR.mkdir(parents=True, exist_ok=True)
        stamp = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
        shutil.copy2(p, BACKUP_DIR / f"{p.stem}.{stamp}{p.suffix}")
        olds = sorted(BACKUP_DIR.glob(f"{p.stem}.*{p.suffix}"))
        for old in olds[:-BACKUP_KEEP]:
            old.unlink(missing_ok=True)

    def restore(self, backup, name):
        src = BACKUP_DIR / Path(backup).name
        if not src.is_file():
            raise ValueError("backup não encontrado")
        text = src.read_text(encoding="utf-8")
        yaml.safe_load(text)  # só restaura YAML válido
        p = self._path(name)
        with self.lock:
            if p.exists():
                self._backup(p)
            tmp = p.with_name(f"_{p.name}.tmp")
            tmp.write_text(text, encoding="utf-8")
            os.replace(tmp, p)

    def backups(self):
        if not BACKUP_DIR.is_dir():
            return []
        return [b.name for b in sorted(BACKUP_DIR.iterdir(), reverse=True)]


def espanso_status():
    exe = shutil.which("espanso")
    if not exe:
        return {"installed": False, "running": False}
    try:
        r = subprocess.run([exe, "status"], capture_output=True, text=True, timeout=5)
        return {"installed": True,
                "running": "is running" in (r.stdout + r.stderr)}
    except Exception:
        return {"installed": True, "running": False}


# --------------------------------------------------------------------------
# Servidor HTTP
# --------------------------------------------------------------------------
class Handler(http.server.BaseHTTPRequestHandler):
    server_version = f"espanso-webui/{VERSION}"

    def log_message(self, *a):
        pass

    # -- segurança: só localhost + token de sessão (anti CSRF / DNS rebinding)
    def _host_ok(self):
        host = (self.headers.get("Host") or "").rsplit(":", 1)[0]
        return host in ("127.0.0.1", "localhost")

    def _send(self, code, body, ctype="application/json; charset=utf-8"):
        if isinstance(body, (dict, list)):
            body = json.dumps(body, ensure_ascii=False)
        if isinstance(body, str):
            body = body.encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("Content-Security-Policy",
                         "default-src 'self'; style-src 'self' 'unsafe-inline'; "
                         "script-src 'self' 'unsafe-inline'")
        self.end_headers()
        self.wfile.write(body)

    def _gate(self, need_token):
        if not self._host_ok():
            self._send(403, {"error": "host inválido"})
            return False
        if need_token and self.headers.get("X-Token") != self.server.token:
            self._send(403, {"error": "token inválido"})
            return False
        return True

    def do_GET(self):
        if not self._gate(False):
            return
        url = urllib.parse.urlparse(self.path)
        q = urllib.parse.parse_qs(url.query)
        if url.path == "/":
            if q.get("t", [""])[0] != self.server.token:
                return self._send(403, "Abra pelo link impresso no terminal.",
                                  "text/plain; charset=utf-8")
            html = (HERE / "ui.html").read_text(encoding="utf-8")
            return self._send(200, html.replace("__TOKEN__", self.server.token),
                              "text/html; charset=utf-8")
        if not self._gate(True):
            return
        self.server.touch()
        st = self.server.store
        try:
            if url.path == "/api/info":
                return self._send(200, {
                    "version": VERSION, "dir": str(st.dir), "files": st.files(),
                    "espanso": espanso_status(), "backups": st.backups(),
                    "idle": self.server.idle_timeout})
            if url.path == "/api/file":
                data, mtime = st.load(q["name"][0])
                data["mtime"] = str(mtime)  # string: ns excede 2^53 do JS
                return self._send(200, data)
            if url.path == "/api/backup":
                f = BACKUP_DIR / Path(q["name"][0]).name
                return self._send(200, f.read_text(encoding="utf-8"),
                                  "text/plain; charset=utf-8")
        except Exception as e:
            return self._send(400, {"error": str(e)})
        self._send(404, {"error": "não encontrado"})

    def do_POST(self):
        if not self._gate(True):
            return
        self.server.touch()
        st = self.server.store
        try:
            n = int(self.headers.get("Content-Length") or 0)
            body = json.loads(self.rfile.read(n) or b"{}")
            path = urllib.parse.urlparse(self.path).path
            if path == "/api/save":
                mtime = st.save(body["name"], body, body.get("mtime"))
                return self._send(200, {"mtime": str(mtime)})
            if path == "/api/preview":
                doc = dict(body.get("extra") or {})
                if body.get("global_vars"):
                    doc["global_vars"] = body["global_vars"]
                doc["matches"] = body.get("matches") or []
                return self._send(200, {"yaml": dump_yaml(doc)})
            if path == "/api/import-beeftext":
                matches, warnings = import_beeftext(body["json"])
                return self._send(200, {"matches": matches, "warnings": warnings})
            if path == "/api/newfile":
                name = body["name"].strip()
                if not name.endswith((".yml", ".yaml")):
                    name += ".yml"
                if (st.dir / name).exists():
                    raise ValueError("já existe um arquivo com esse nome")
                st.save(name, {"matches": []}, None)
                return self._send(200, {"name": name})
            if path == "/api/restore":
                st.restore(body["name"], body["file"])
                return self._send(200, {"ok": True})
            if path == "/api/shutdown":
                self._send(200, {"ok": True})
                threading.Thread(target=self.server.shutdown, daemon=True).start()
                return
        except FileExistsError as e:
            return self._send(409, {"error": str(e)})
        except Exception as e:
            return self._send(400, {"error": str(e)})
        self._send(404, {"error": "não encontrado"})


class Server(http.server.ThreadingHTTPServer):
    daemon_threads = True

    def __init__(self, addr, store, idle_timeout):
        super().__init__(addr, Handler)
        self.store = store
        self.token = secrets.token_urlsafe(24)
        self.idle_timeout = idle_timeout
        self.last = time.monotonic()

    def touch(self):
        self.last = time.monotonic()

    def watch_idle(self):
        while True:
            time.sleep(15)
            if self.idle_timeout and time.monotonic() - self.last > self.idle_timeout * 60:
                print(f"\nSem uso por {self.idle_timeout} min: encerrando.")
                self.shutdown()
                return


def default_match_dir():
    try:
        r = subprocess.run(["espanso", "path", "config"], capture_output=True,
                           text=True, timeout=5)
        cfg = r.stdout.strip().splitlines()
        # "espanso path config" -> diretório de configuração
        if r.returncode == 0 and cfg and Path(cfg[0]).is_dir():
            return Path(cfg[0]) / "match"
    except Exception:
        pass
    base = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
    return base / "espanso" / "match"


def free_port(preferred):
    for p in [preferred] + list(range(preferred + 1, preferred + 20)):
        with socket.socket() as s:
            if s.connect_ex(("127.0.0.1", p)) != 0:
                return p
    raise SystemExit("nenhuma porta livre encontrada")


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument("--match-dir", help="pasta match do espanso (padrão: detecta)")
    ap.add_argument("--port", type=int, default=8765)
    ap.add_argument("--idle", type=int, default=15, metavar="MIN",
                    help="encerra após N minutos sem uso (0 = nunca; padrão 15)")
    ap.add_argument("--no-browser", action="store_true")
    ap.add_argument("--version", action="version", version=VERSION)
    a = ap.parse_args()

    match_dir = Path(a.match_dir).expanduser() if a.match_dir else default_match_dir()
    srv = Server(("127.0.0.1", free_port(a.port)), Store(match_dir), a.idle)
    url = f"http://127.0.0.1:{srv.server_address[1]}/?t={srv.token}"
    print(f"espanso-webui {VERSION}\n  pasta: {match_dir}\n  abra:  {url}\n"
          f"  (Ctrl+C para encerrar; sem uso por {a.idle} min também encerra)",
          flush=True)
    if a.idle:
        threading.Thread(target=srv.watch_idle, daemon=True).start()
    if not a.no_browser:
        threading.Timer(0.4, lambda: webbrowser.open(url)).start()
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        srv.server_close()
        print("encerrado.")


if __name__ == "__main__":
    main()
